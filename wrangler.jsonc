{
  "name": "kvm",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "cache": {
    "enabled": true,
  },
  "placement": {
    "mode": "smart",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "issue_detection": {
      "enabled": true,
    },
  },
}
