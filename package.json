{
  "name": "zjkvm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ZJKVM — a USB KVM console in the ZJ design language",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy",
    "tsc": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "icons": "node scripts/generate-icons.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "jotai": "^3.0.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-serial": "^1.0.9",
    "@vitejs/plugin-react": "^6.2.0",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.1"
  },
  "packageManager": "pnpm@12.6.0"
}
